.DS_Store

# Xcode leftovers. SpatialCore is a SwiftPM package; `.build/` is its output.
ios/*.xcodeproj/
ios/*.xcworkspace/
.build/
DerivedData/
*.xcuserdatad
xcuserdata/

node_modules/
.env
*.log

__pycache__/
*.pyc

# LaMa (diminished-reality eraser's optional learned fill), 187MB. Fetched by
# tools/fetch_lama.py, not committed — see that script's doc comment. Served
# by the server's /assets route rather than bundled.
models/LaMa.mlmodelc/

# Expo generated projects and session artifacts
mobile/.expo/
mobile/ios/
mobile/android/
mobile/dist/
server/.sessions/

# Reconstruction worker: model weights are hundreds of MB and fetched on demand,
# stage dumps are debugging output.
models/
workers/reconstruction/.selftest-out/
workers/reconstruction/__pycache__/

# Furniture worker: downloaded weights, environments, generated assets, and trials.
workers/furniture/.local/
workers/furniture/.venv/

# Generated catalog GLBs are committed so a clone is self-contained: the manifest
# references them by hash, and a missing file is a 404 at demo time. ~4MB each.
# `.objects/` is per-request scratch from live generation and is not committed.
.objects/

# Spike meshes: the stripped ones rebuild free from the catalog via strip.mjs.
# The generated ones cost credits, so they stay.
spikes/**/meshes/*
!spikes/**/meshes/index.json
!spikes/**/meshes/gen-*
!spikes/**/meshes/img-*
