{
  "name": "reality-editor",
  "private": true,
  "version": "0.2.0",
  "workspaces": [
    "mobile",
    "packages/*",
    "server"
  ],
  "scripts": {
    "dev": "npm run start --workspace @reality/mobile",
    "server": "npm run dev --workspace reality-editor-server",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace @reality/mobile && npm run typecheck --workspace reality-editor-server",
    "codegen": "bash contracts/codegen.sh",
    "gate": "tsx mobile/src/runtime/gate.ts && tsx packages/blueprint/selftest.ts && npm run gate:objects && tsx server/src/gate.ts && python3 workers/reconstruction/selftest.py && python3 workers/reconstruction/appearance_selftest.py && python3 workers/reconstruction/erase_selftest.py",
    "gate:app": "tsx mobile/src/runtime/gate.ts",
    "gate:blueprint": "tsx packages/blueprint/selftest.ts",
    "gate:objects": "tsx --test \"packages/object-spec/src/*.test.ts\" \"server/src/objects/*.test.ts\"",
    "gate:server": "tsx server/src/gate.ts",
    "gate:worker": "python3 workers/reconstruction/selftest.py",
    "gate:appearance": "python3 workers/reconstruction/appearance_selftest.py",
    "cases": "python3 workers/reconstruction/cases.py",
    "e2e:reconstruction": "python3 tools/reconstruct-e2e.py",
    "gate:erase": "python3 workers/reconstruction/erase_selftest.py"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsx": "^4.19.2",
    "@types/node": "^22.10.5"
  },
  "overrides": {
    "react-native-gesture-handler": "~2.32.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
