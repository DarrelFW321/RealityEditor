# Copy to .env. NEVER commit .env — it is in .gitignore.
#
# Neither of these keys ever reaches the phone. /session mints a short-lived
# ephemeral client secret from OPENAI_API_KEY and returns only that; the phone
# never sees this file's contents.

# Realtime voice model. Used only by POST /session.
OPENAI_API_KEY=sk-proj-...

# Style planner. Used only by POST /plan_style, which is off the critical path.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
PORT=8787
HOST=0.0.0.0

# Realtime model id. Verify against the current docs before changing —
# this interface went from beta to GA and the model ids moved with it.
REALTIME_MODEL=gpt-realtime-2.1

# Ephemeral client-secret lifetime, seconds. Range 10..7200, API default 600.
# Mint at SESSION START, not app launch, and re-mint on reconnect.
REALTIME_TOKEN_TTL_SECONDS=600

# Optional separate reconstruction worker; leave unset until a registered-frame pipeline is deployed.
RECONSTRUCTION_WORKER_URL=
RECONSTRUCTION_WORKER_TOKEN=
# Dedicated private directory for ephemeral session assets. Single-process backend only.
SESSION_STORAGE_DIR=.sessions
